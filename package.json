{
  "name": "cfmail",
  "version": "1.0.0",
  "description": "Cloudflare 原生全栈域名邮箱管理系统",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:init:local": "wrangler d1 execute cfmail_db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cfmail_db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare",
    "email-routing",
    "cloudflare-workers",
    "webmail",
    "d1",
    "postal-mime"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261113.1",
    "typescript": "^5.7.2",
    "wrangler": "^3.114.15"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "postal-mime": "^2.2.1"
  }
}
